<odoo>
    <!-- Transaction Log Wizard -->
    <record id="view_amacheck_transaction_wizard_form" model="ir.ui.view">
        <field name="name">amacheck.transaction.wizard.form</field>
        <field name="model">amacheck.transaction.wizard</field>
        <field name="arch" type="xml">
            <form string="AMACheck Transaction Log">
                <field name="line_ids" readonly="0">
                    <list string="Transactions"
                          decoration-danger="send_state == 'failed'"
                          decoration-warning="send_state in ('unconfirmed', 'pending')"
                          delete="0" create="0" edit="0">
                        <field name="trans_date"    optional="show"/>
                        <field name="check_no"      optional="show"/>
                        <field name="payee"         optional="show"/>
                        <field name="bank"          optional="show"/>
                        <field name="bank_account"  optional="show"/>
                        <field name="amount"        optional="show"/>
                        <field name="send_state"    optional="show"/>
                        <field name="checkeeper_id" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button string="Export to CSV" name="action_export_csv" type="object" class="btn-primary"/>
                    <button string="Back" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Transaction Line Detail Form -->
    <record id="view_amacheck_transaction_line_form" model="ir.ui.view">
        <field name="name">amacheck.transaction.line.form</field>
        <field name="model">amacheck.transaction.line</field>
        <field name="arch" type="xml">
            <form string="Transaction Detail" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Check">
                            <field name="check_no"/>
                            <field name="trans_date"/>
                            <field name="amount"/>
                            <field name="send_state"/>
                            <field name="check_status" invisible="send_state != 'sent'"/>
                        </group>
                        <group string="Payee">
                            <field name="payee"/>
                            <field name="bank"/>
                            <field name="bank_account"/>
                        </group>
                    </group>
                    <group string="Details" invisible="not result">
                        <field name="result" nolabel="1" colspan="2"/>
                    </group>
                    <field name="wizard_id"     invisible="1"/>
                    <field name="checkeeper_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
