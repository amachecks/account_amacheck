<odoo>
    <!-- Transaction Log Wizard -->
    <record id="view_amacheck_transaction_wizard_form" model="ir.ui.view">
        <field name="name">amacheck.transaction.wizard.form</field>
        <field name="model">amacheck.transaction.wizard</field>
        <field name="arch" type="xml">
            <form string="AMACheck Transaction Log">
                <field name="line_ids" readonly="1">
                    <list string="Transactions" decoration-danger="result != '' and result != 'OK'" no_open="1">
                        <field name="trans_date"    string="Transaction Date" optional="show"/>
                        <field name="check_no"      string="Check Number"     optional="show"/>
                        <field name="payee"         string="Payee"            optional="show"/>
                        <field name="bank"          string="Bank"             optional="show"/>
                        <field name="bank_account"  string="Account"          optional="show"/>
                        <field name="amount"        string="Amount"           optional="show" widget="monetary"/>
                        <field name="checkeeper_id" string="Check ID"         optional="hide"/>
                        <field name="check_status"  string="Status"           optional="hide"/>
                        <button name="action_view_detail" type="object"
                                string="Details"
                                class="btn-sm btn-secondary"/>
                    </list>
                </field>
                <footer>
                    <button string="Export to CSV" name="action_export_csv" type="object" class="btn-primary"/>
                    <button string="Back" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Transaction Line Detail Form -->
    <record id="view_amacheck_transaction_line_form" model="ir.ui.view">
        <field name="name">amacheck.transaction.line.form</field>
        <field name="model">amacheck.transaction.line</field>
        <field name="arch" type="xml">
            <form string="Transaction Detail">
                <sheet>
                    <group>
                        <group string="Check">
                            <field name="check_no"     string="Check Number"/>
                            <field name="trans_date"   string="Transaction Date"/>
                            <field name="amount"       string="Amount" widget="monetary"/>
                        </group>
                        <group string="Payee">
                            <field name="payee"        string="Payee"/>
                            <field name="bank"         string="Bank"/>
                            <field name="bank_account" string="Account"/>
                        </group>
                    </group>
                    <group string="Check Status">
                        <field name="check_status"  string="Status"/>
                        <field name="status_date"   string="Last Updated"/>
                        <field name="checkeeper_id" string="Check ID"/>
                    </group>
                    <group string="Result">
                        <field name="result" string="" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <field name="wizard_id" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
