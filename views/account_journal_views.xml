<odoo>
    <record id="view_journal_form_amacheck" model="ir.ui.view">
        <field name="name">account.journal.form.amacheck</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">

                <group string="AMACheck Settings" invisible="type != 'bank'">
                    <field name="amacheck_is_ocw" invisible="1"/>
                    <field name="amacheck_assign_check_no" invisible="1"/>

                    <group invisible="not amacheck_is_ocw">
                        <field name="amacheck_bank_account_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="amacheck_next_check_no"
                               string="Next Check Number"
                               invisible="not amacheck_assign_check_no"/>
                    </group>

                    <group invisible="not amacheck_is_ocw">
                        <field name="amacheck_sync_state" readonly="1"/>
                        <field name="amacheck_sync_error" readonly="1" style="color: red;"/>
                    </group>

                    <group invisible="not amacheck_is_ocw">
                        <button name="action_amacheck_test_connection"
                                string="Test AMACheck Connection"
                                type="object"
                                class="btn-secondary"/>

                        <button name="action_amacheck_sync_bank_account"
                                string="Sync AMACheck Bank Account"
                                type="object"
                                class="btn-primary"/>
                    </group>
                </group>

            </xpath>
        </field>
    </record>
</odoo>
