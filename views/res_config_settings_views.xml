<odoo>
    <record id="res_config_settings_view_form_amacheck" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.amacheck</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AMACheck" string="AMACheck" name="account_amacheck">
                    <field name="account_amacheck_is_ocw" invisible="1"/>
                    <block title="AMACheck API Settings" invisible="not account_amacheck_is_ocw">
                        <setting string="Environment"
                                 help="Use Sandbox for testing or Production for live transactions."
                                 invisible="not account_amacheck_allow_sandbox or not account_amacheck_is_ocw">
                            <field name="account_amacheck_environment" widget="radio"/>
                            <field name="account_amacheck_allow_sandbox" invisible="1"/>
                        </setting>
                    </block>

                    <block title="AMACheck Status">
                        <setting string="License Code" help="AMAChecks License Code">
                            <field name="account_amacheck_license_code"/>
                            <button name="action_amacheck_refresh_status"
                                    string="Refresh Balance"
                                    type="object"
                                    class="btn-secondary ms-2"/>
                        </setting>

                        <setting string="eChecks Available">
                            <field name="account_amacheck_checks_left" readonly="1"/>
                            <div class="mt8">
                                <a href="https://amachecks.com/product/echeck-bundles/"
                                   target="_blank"
                                   style="font-weight: bold; color: #0d6efd;">Buy More eChecks</a>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
