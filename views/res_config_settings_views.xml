<odoo>
    <record id="res_config_settings_view_form_amacheck" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.amacheck</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AMACheck" string="AMACheck" name="account_amacheck">
                    <block title="AMACheck Information">
                        <setting string="License Code"
                                 help="Enter your AMAChecks license code, then click Refresh Balance.">
                            <field name="account_amacheck_license_code"/>
                            <button name="action_amacheck_refresh_status"
                                    string="Refresh Balance"
                                    type="object"
                                    class="btn-secondary ms-2"/>
                            <div class="text-muted mt8" invisible="not account_amacheck_customer_name">
                                Licensed to <field name="account_amacheck_customer_name" class="oe_inline"/>
                            </div>
                        </setting>

                        <setting string="eChecks Available">
                            <field name="account_amacheck_checks_left" readonly="1"/>
                            <div class="mt8">
                                <a href="https://www.amasystems.net/shop/echeck-10-pack-33"
                                   target="_blank"
                                   style="font-weight: bold; color: #0d6efd;">Buy More eChecks</a>
                            </div>
                        </setting>
                    </block>

                    <block title="Transaction Log">
                        <setting string="View check send history for this license">
                            <button name="action_view_transactions"
                                    string="View Transaction Log"
                                    type="object"
                                    class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
