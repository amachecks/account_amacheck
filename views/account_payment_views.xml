<odoo>
    <record id="view_payment_form_amacheck" model="ir.ui.view">
        <field name="name">account.payment.form.amacheck</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_amacheck"
                        type="object"
                        string="Send Check"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
		<group string="AMACheck">
		    <field name="x_amacheck_state"/>
		    <field name="x_amacheck_zil_id"/>
		    <field name="x_amacheck_sent_at"/>
		    <field name="x_amacheck_error"/>
		</group>
            </xpath>
        </field>
    </record>
</odoo>
