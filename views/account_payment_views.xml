<odoo>
    <record id="view_payment_form_amacheck" model="ir.ui.view">
        <field name="name">account.payment.form.amacheck</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_amacheck"
                        type="object"
                        string="Send Check"
                        class="btn-primary"
                        invisible="payment_type != 'outbound' or amacheck_state == 'sent'"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="amacheck_inactive" invisible="1"/>
                <group string="AMACheck" invisible="not amacheck_state">
                    <field name="amacheck_state"/>
                    <field name="amacheck_check_number"/>
                    <field name="amacheck_zil_id"/>
                    <field name="amacheck_sent_at"/>
                    <field name="amacheck_error"
                           style="color: red;"
                           invisible="amacheck_inactive or not amacheck_error"/>
                    <div invisible="not amacheck_inactive" style="color: red;" colspan="2">
                        Your AMAChecks license is inactive. Please
                        <a href="https://www.amasystems.net/shop/echeck-10-pack-33"
                           target="_blank"
                           style="font-weight: bold; color: #0d6efd;">RENEW</a>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
