<odoo>
    <record id="view_payment_form_amacheck" model="ir.ui.view">
        <field name="name">account.payment.form.amacheck</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_amacheck"
                        type="object"
                        string="Send Check"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="amacheck_inactive" invisible="1"/>
                <group string="AMACheck">
                    <field name="amacheck_state" string="Status"/>
                    <field name="amacheck_zil_id" string="Check ID"/>
                    <field name="amacheck_check_number" string="Check Number"/>
                    <field name="amacheck_sent_at" string="Sent On"/>
                    <field name="amacheck_error" string="Errors" style="color: red;"
                           invisible="amacheck_inactive"/>
                    <div invisible="not amacheck_inactive" style="color: red;">
                        Your AMAChecks subscription is inactive. Please
                        <a href="https://amachecks.com/shop/"
                           target="_blank"
                           style="font-weight: bold; color: #0d6efd;">RENEW</a>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
